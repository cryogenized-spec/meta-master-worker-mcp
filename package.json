{
  "name": "meta-master-worker-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable Cloudflare-native Meta MCP foundation",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "build": "npm run build:resource && npm run build:auth",
    "deploy": "wrangler deploy",
    "build:resource": "wrangler deploy --dry-run --outdir dist",
    "build:auth": "wrangler deploy --config apps/auth/wrangler.jsonc --dry-run --outdir dist-auth"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "5.20261110.1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.31.0",
    "zod": "^4.2.0"
  }
}
