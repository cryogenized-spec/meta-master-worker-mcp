# Copy this outside Git; the project NEVER starts a session by default.
BAILEYS_ENABLE=false
BAILEYS_ALLOW_PAIRING=false
BAILEYS_BRIDGE_URL=https://your-worker.example/internal/whatsapp/baileys
BAILEYS_BRIDGE_ID=omen-local
BAILEYS_BRIDGE_HMAC_KEY=replace-with-base64url-of-32-random-bytes
# Explicit individual-chat IDs only. No "*" wildcard or group-chat forwarding.
BAILEYS_ALLOWED_JIDS=1234567890@s.whatsapp.net
# Optional. Default is a private per-user folder outside this repository.
# BAILEYS_SESSION_DIR=/home/you/.local/share/meta-master-baileys

# Mandatory only when BAILEYS_ENABLE=true. Independent 32-byte AES-256 key,
# never reuse the bridge HMAC key or Cloudflare data encryption key.
BAILEYS_SPOOL_KEY=replace-with-separate-base64url-32-byte-random-value
# Local persistent encrypted queue, NOT inside repository and not in Docker.
# BAILEYS_SPOOL_DIR=/home/you/.local/share/meta-master-baileys-spool
